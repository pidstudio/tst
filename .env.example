# ===== Telegram =====
# คุยกับ @BotFather เพื่อสร้างบอทและเอา token
BOT_TOKEN=123456:ABC-your-bot-token
# URL ของเว็บแอป (ต้องเป็น https ตอน production) ใช้ตั้ง Menu Button / WebApp
WEBAPP_URL=https://your-domain.example.com
# Telegram user id ของแอดมิน (คั่นด้วย comma) — มีสิทธิ์สร้าง/แก้รายการประมูล
ADMIN_IDS=123456789

# ===== Server =====
PORT=3000
# ใส่ค่าสุ่มยาวๆ สำหรับเซ็น session token
SESSION_SECRET=change-me-to-a-long-random-string

# ===== Dev =====
# ตั้ง true เพื่อข้ามการ verify initData ตอนพัฒนา (ห้ามใช้ตอน production)
DEV_BYPASS_AUTH=false
